{
  "_comment": "Copy this file to appsettings.Production.json (gitignored - never commit the real one) and fill in real values. ASP.NET Core layers appsettings.{ASPNETCORE_ENVIRONMENT}.json on top of appsettings.json automatically, so anything you don't override here still falls back to the base file's value.",

  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=your_production_db;Username=your_api_user;Password=REPLACE_ME"
  },

  "Jwt": {
    "_comment": "The base appsettings.json's SecretKey is a shared dev value - generate and set a real one here for production; anyone with that key can forge valid tokens.",
    "SecretKey": "REPLACE_ME_WITH_A_LONG_RANDOM_PRODUCTION_SECRET"
  },

  "App": {
    "FrontendBaseUrl": "https://your-production-frontend-domain",
    "_comment_AutoMigrateOnStartup": "false so the API never silently applies schema changes (or seeds the documented demo accounts) against a real database just by starting - run 'dotnet ef database update' as its own deliberate step instead. See README.md's Deploying to a server section.",
    "AutoMigrateOnStartup": false
  },

  "Email": {
    "_comment": "The base appsettings.json's Email block is a shared dev value - override it here with a real mailbox. For Gmail, SmtpUsername is the full address and SmtpPassword must be a 16-character App Password (Google Account > Security > 2-Step Verification > App passwords), not the account's login password - Gmail rejects SMTP auth with the real password once 2FA is on.",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "REPLACE_ME@gmail.com",
    "SmtpPassword": "REPLACE_ME_APP_PASSWORD",
    "FromAddress": "REPLACE_ME@gmail.com",
    "FromName": "KhoiHub"
  },

  "Cors": {
    "AllowedOrigins": [ "https://your-production-frontend-domain" ],
    "_comment_AllowAnyOrigin": "Set true temporarily to unblock a freshly deployed frontend before you know its exact origin (reflects back whatever Origin header the browser sends, with credentials - any website can call this API while this is on). Once you know the real origin, put it in AllowedOrigins above and set this back to false/remove it - do not leave this on in a real deployment.",
    "AllowAnyOrigin": false,
    "_comment_PreviewOriginPattern": "Optional regex for a whole family of origins that can't be listed exactly - e.g. Vercel preview deployments get a new *.vercel.app subdomain per PR/branch. Scope it to your own project's preview subdomains rather than matching all of *.vercel.app. Omit this key entirely if you don't need it.",
    "PreviewOriginPattern": "^https://your-project-name-[a-z0-9-]+\\.vercel\\.app$"
  }
}
